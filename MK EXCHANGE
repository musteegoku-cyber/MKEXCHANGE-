<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <meta
    name="description"
    content="MK EXCHANGE provides airtime conversion, cryptocurrency, USDT, gas fees, Telegram Stars, Pi, Sidra and Gate P2P services. Available 24/7."
  >

  <meta
    name="theme-color"
    content="#071A2B"
  >

  <title>MK EXCHANGE | Digital Exchange Made Simple</title>

  <style>

    /* =========================================================
       ROOT
    ========================================================= */

    :root {
      --blue: #4FA3D1;
      --blue-dark: #103B5C;
      --blue-soft: #DFF3FF;

      --navy: #071A2B;
      --navy-2: #0B263D;
      --navy-3: #123D5C;

      --white: #FFFFFF;
      --off-white: #F7FAFC;

      --text: #0F172A;
      --muted: #64748B;
      --muted-light: #AFC1CF;

      --green: #25D366;
      --green-dark: #128C7E;
      --green-soft: #E8FFF0;

      --border: #E2E8F0;
      --border-dark: rgba(255,255,255,0.10);

      --shadow-sm:
        0 8px 25px rgba(7,26,43,0.06);

      --shadow-md:
        0 18px 45px rgba(7,26,43,0.11);

      --shadow-lg:
        0 30px 80px rgba(7,26,43,0.20);

      --radius-sm: 12px;
      --radius-md: 18px;
      --radius-lg: 28px;

      --max-width: 1180px;
    }


    /* =========================================================
       RESET
    ========================================================= */

    *,
    *::before,
    *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
      scroll-padding-top: 85px;
    }

    body {
      font-family:
        Inter,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;

      background: var(--off-white);
      color: var(--text);

      line-height: 1.6;

      overflow-x: hidden;
    }

    body.menu-open {
      overflow: hidden;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button {
      font: inherit;
      cursor: pointer;
    }

    img {
      max-width: 100%;
      display: block;
    }

    ::selection {
      background: var(--blue);
      color: var(--navy);
    }


    /* =========================================================
       GLOBAL
    ========================================================= */

    .container {
      width: min(
        var(--max-width),
        calc(100% - 40px)
      );

      margin: 0 auto;
    }

    section {
      padding: 100px 0;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;

      padding: 7px 12px;

      border:
        1px solid
        rgba(79,163,209,0.28);

      border-radius: 999px;

      background:
        rgba(79,163,209,0.08);

      color: #2877A5;

      font-size: 0.70rem;
      font-weight: 900;

      letter-spacing: 1px;
      text-transform: uppercase;
    }

    .eyebrow-dark {
      color: var(--blue);

      border-color:
        rgba(79,163,209,0.20);

      background:
        rgba(79,163,209,0.08);
    }

    .dot {
      width: 7px;
      height: 7px;

      border-radius: 50%;

      background: var(--green);
    }

    .section-heading {
      max-width: 720px;

      margin-bottom: 48px;
    }

    .section-heading.center {
      margin-left: auto;
      margin-right: auto;

      text-align: center;
    }

    .section-heading h2 {
      margin-top: 15px;
      margin-bottom: 14px;

      color: var(--navy);

      font-size:
        clamp(2.2rem, 5vw, 3.7rem);

      line-height: 1.03;

      letter-spacing: -2.5px;
    }

    .section-heading p {
      color: var(--muted);

      font-size: 0.95rem;
    }

    .section-heading.center p {
      max-width: 650px;

      margin-left: auto;
      margin-right: auto;
    }


    /* =========================================================
       BUTTONS
    ========================================================= */

    .button {
      min-height: 52px;

      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 9px;

      padding: 0 20px;

      border: 0;
      border-radius: 12px;

      font-size: 0.84rem;
      font-weight: 900;

      transition:
        transform 0.2s ease,
        box-shadow 0.2s ease,
        background 0.2s ease;
    }

    .button:hover {
      transform: translateY(-2px);
    }

    .button-primary {
      background: var(--blue);

      color: var(--navy);

      box-shadow:
        0 12px 28px
        rgba(79,163,209,0.25);
    }

    .button-primary:hover {
      background: #69B7DF;

      box-shadow:
        0 16px 35px
        rgba(79,163,209,0.30);
    }

    .button-whatsapp {
      background: var(--green);

      color: #062B18;

      box-shadow:
        0 12px 28px
        rgba(37,211,102,0.20);
    }

    .button-whatsapp:hover {
      background: #42DF7B;
    }

    .button-dark {
      background: var(--navy);

      color: var(--white);
    }

    .button-dark:hover {
      background: var(--blue-dark);
    }

    .button-light {
      background: var(--white);

      color: var(--navy);

      border:
        1px solid
        var(--border);
    }

    .button-light:hover {
      border-color: var(--blue);
    }

    .button-full {
      width: 100%;
    }


    /* =========================================================
       HEADER
    ========================================================= */

    .header {
      position: fixed;

      top: 0;
      left: 0;

      width: 100%;

      z-index: 1000;

      background:
        rgba(255,255,255,0.90);

      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);

      border-bottom:
        1px solid
        transparent;

      transition:
        border-color 0.25s ease,
        box-shadow 0.25s ease;
    }

    .header.scrolled {
      border-color: var(--border);

      box-shadow:
        0 5px 25px
        rgba(7,26,43,0.06);
    }

    .nav {
      min-height: 74px;

      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .brand {
      display: inline-flex;
      align-items: center;
      gap: 10px;

      font-weight: 950;
    }

    .brand-mark {
      width: 39px;
      height: 39px;

      display: grid;
      place-items: center;

      border-radius: 11px;

      background:
        linear-gradient(
          135deg,
          var(--blue),
          #8DD8F5
        );

      color: var(--navy);

      font-size: 0.70rem;
      font-weight: 950;
    }

    .brand-name {
      color: var(--navy);

      letter-spacing: -0.3px;
    }

    .brand-name span {
      color: #2877A5;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 25px;

      list-style: none;
    }

    .nav-links > li > a:not(.nav-cta) {
      color: #475569;

      font-size: 0.82rem;
      font-weight: 750;
    }

    .nav-links > li > a:not(.nav-cta):hover {
      color: #2877A5;
    }

    .nav-cta {
      min-height: 43px;

      display: inline-flex;
      align-items: center;

      padding: 0 16px;

      border-radius: 10px;

      background: var(--navy);

      color: var(--white);

      font-size: 0.78rem;
      font-weight: 900;
    }

    .menu-button {
      display: none;

      width: 43px;
      height: 43px;

      border:
        1px solid
        var(--border);

      border-radius: 11px;

      background: var(--white);

      color: var(--navy);
    }


    /* =========================================================
       HERO
    ========================================================= */

    .hero {
      position: relative;

      min-height: 790px;

      display: flex;
      align-items: center;

      padding-top: 130px;

      background:
        radial-gradient(
          circle at 85% 15%,
          rgba(79,163,209,0.20),
          transparent 30%
        ),
        radial-gradient(
          circle at 5% 85%,
          rgba(79,163,209,0.10),
          transparent 30%
        ),
        var(--navy);

      color: var(--white);

      overflow: hidden;
    }

    .hero::before {
      content: "";

      position: absolute;

      width: 500px;
      height: 500px;

      right: -240px;
      bottom: -260px;

      border-radius: 50%;

      background:
        rgba(79,163,209,0.10);

      filter: blur(70px);
    }

    .hero-grid {
      position: relative;
      z-index: 1;

      display: grid;

      grid-template-columns:
        minmax(0, 1.08fr)
        minmax(360px, 0.92fr);

      gap: 70px;

      align-items: center;
    }

    .hero-content {
      max-width: 680px;
    }

    .availability {
      display: inline-flex;
      align-items: center;
      gap: 8px;

      margin-bottom: 16px;

      padding: 8px 12px;

      border:
        1px solid
        rgba(37,211,102,0.24);

      border-radius: 999px;

      background:
        rgba(37,211,102,0.07);

      color: #8AF0AC;

      font-size: 0.70rem;
      font-weight: 900;
    }

    .hero h1 {
      margin: 18px 0 21px;

      font-size:
        clamp(3rem, 7vw, 5.8rem);

      line-height: 0.98;

      letter-spacing: -4px;
    }

    .hero h1 span {
      color: var(--blue);
    }

    .hero-subtitle {
      margin-bottom: 13px;

      color: #DFF3FF;

      font-size: 1.05rem;
      font-weight: 800;
    }

    .hero-description {
      max-width: 610px;

      margin-bottom: 27px;

      color: #B4C9D8;

      font-size: 0.94rem;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .hero-actions .button-whatsapp {
      min-width: 210px;
    }

    .hero-reassurance {
      display: flex;
      flex-wrap: wrap;
      gap: 18px;

      margin-top: 23px;
    }

    .reassurance-item {
      display: flex;
      align-items: center;
      gap: 7px;

      color: #AFC4D4;

      font-size: 0.73rem;
      font-weight: 700;
    }

    .check {
      width: 19px;
      height: 19px;

      display: grid;
      place-items: center;

      border-radius: 50%;

      background:
        rgba(37,211,102,0.12);

      color: #75E99B;

      font-size: 0.62rem;
      font-weight: 950;
    }


    /* =========================================================
       HERO CARD
    ========================================================= */

    .hero-card {
      position: relative;

      padding: 23px;

      border:
        1px solid
        rgba(79,163,209,0.18);

      border-radius: 28px;

      background:
        linear-gradient(
          145deg,
          rgba(16,59,92,0.97),
          rgba(7,26,43,0.98)
        );

      box-shadow: var(--shadow-lg);
    }

    .hero-card-top {
      display: flex;
      justify-content: space-between;
      align-items: center;

      margin-bottom: 17px;
    }

    .hero-card-title {
      color: #B7C9D7;

      font-size: 0.70rem;
      font-weight: 900;

      letter-spacing: 1.2px;
    }

    .live {
      display: flex;
      align-items: center;
      gap: 6px;

      color: #8AF0AC;

      font-size: 0.68rem;
      font-weight: 900;
    }

    .live-dot {
      width: 6px;
      height: 6px;

      border-radius: 50%;

      background: var(--green);
    }

    .hero-card-main {
      padding: 23px;

      border:
        1px solid
        rgba(255,255,255,0.08);

      border-radius: 19px;

      background:
        rgba(255,255,255,0.035);
    }

    .card-label {
      color: #8FA7B9;

      font-size: 0.66rem;
      font-weight: 850;

      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .hero-card-main h2 {
      margin: 6px 0 5px;

      font-size: 1.55rem;

      letter-spacing: -0.8px;
    }

    .hero-card-main p {
      color: #8FA7B9;

      font-size: 0.76rem;
    }

    .rate-list {
      display: grid;
      gap: 9px;

      margin-top: 17px;
    }

    .rate {
      display: flex;
      align-items: center;
      justify-content: space-between;

      padding: 13px;

      border:
        1px solid
        rgba(255,255,255,0.07);

      border-radius: 12px;

      background:
        rgba(255,255,255,0.025);
    }

    .rate-name {
      display: flex;
      align-items: center;
      gap: 9px;

      font-size: 0.82rem;
      font-weight: 850;
    }

    .network {
      width: 31px;
      height: 31px;

      display: grid;
      place-items: center;

      border-radius: 9px;

      background:
        rgba(79,163,209,0.12);

      color: var(--blue);

      font-size: 0.65rem;
      font-weight: 950;
    }

    .rate-value {
      color: var(--blue);

      font-size: 1.18rem;
      font-weight: 950;
    }

    .rate-note {
      margin-top: 11px;

      color: #718B9E;

      font-size: 0.65rem;
    }

    .hero-card-actions {
      display: grid;
      gap: 9px;

      margin-top: 12px;
    }


    /* =========================================================
       TRUST BAR
    ========================================================= */

    .trust-bar {
      position: relative;
      z-index: 10;

      margin-top: -35px;
    }

    .trust-grid {
      display: grid;

      grid-template-columns:
        repeat(3, 1fr);

      gap: 1px;

      padding: 1px;

      background: var(--border);

      border-radius: 20px;

      overflow: hidden;

      box-shadow: var(--shadow-md);
    }

    .trust-item {
      padding: 23px;

      background: var(--white);

      text-align: center;
    }

    .trust-item strong {
      display: block;

      color: var(--navy);

      font-size: 1.25rem;
    }

    .trust-item span {
      color: var(--muted);

      font-size: 0.70rem;
    }


    /* =========================================================
       PSYCHOLOGY SECTION
    ========================================================= */

    .confidence-section {
      background: var(--white);
    }

    .confidence-grid {
      display: grid;

      grid-template-columns:
        repeat(3, 1fr);

      gap: 15px;
    }

    .confidence-card {
      padding: 25px;

      border:
        1px solid
        var(--border);

      border-radius: 18px;

      background: var(--white);

      box-shadow:
        0 5px 20px
        rgba(7,26,43,0.035);
    }

    .confidence-number {
      width: 39px;
      height: 39px;

      display: grid;
      place-items: center;

      margin-bottom: 17px;

      border-radius: 11px;

      background: var(--blue-soft);

      color: var(--blue-dark);

      font-size: 0.75rem;
      font-weight: 950;
    }

    .confidence-card h3 {
      margin-bottom: 7px;

      color: var(--navy);

      font-size: 1rem;
    }

    .confidence-card p {
      color: var(--muted);

      font-size: 0.79rem;
    }


    /* =========================================================
       SERVICES
    ========================================================= */

    .services-section {
      background: var(--off-white);
    }

    .services-grid {
      display: grid;

      grid-template-columns:
        repeat(4, 1fr);

      gap: 14px;
    }

    .service-card {
      position: relative;

      padding: 23px;

      border:
        1px solid
        var(--border);

      border-radius: 18px;

      background: var(--white);

      transition:
        transform 0.2s ease,
        border-color 0.2s ease,
        box-shadow 0.2s ease;
    }

    .service-card:hover {
      transform: translateY(-5px);

      border-color:
        rgba(79,163,209,0.40);

      box-shadow: var(--shadow-sm);
    }

    .service-card.featured {
      border-color:
        rgba(79,163,209,0.35);

      box-shadow:
        0 10px 30px
        rgba(79,163,209,0.08);
    }

    .service-badge {
      position: absolute;

      top: 14px;
      right: 14px;

      padding: 5px 8px;

      border-radius: 7px;

      background: var(--blue-soft);

      color: var(--blue-dark);

      font-size: 0.57rem;
      font-weight: 950;

      text-transform: uppercase;
    }

    .service-icon {
      width: 43px;
      height: 43px;

      display: grid;
      place-items: center;

      margin-bottom: 17px;

      border-radius: 12px;

      background: var(--blue-soft);

      color: var(--blue-dark);

      font-size: 0.65rem;
      font-weight: 950;
    }

    .service-card h3 {
      margin-bottom: 7px;

      color: var(--navy);

      font-size: 0.98rem;
    }

    .service-card p {
      min-height: 48px;

      color: var(--muted);

      font-size: 0.76rem;
    }

    .service-action {
      display: inline-flex;

      margin-top: 14px;

      color: #2877A5;

      font-size: 0.70rem;
      font-weight: 900;
    }


    /* =========================================================
       AIRTIME
    ========================================================= */

    .airtime-section {
      background: var(--blue-soft);
    }

    .airtime-grid {
      display: grid;

      grid-template-columns:
        repeat(2, 1fr);

      gap: 17px;
    }

    .airtime-card {
      padding: 30px;

      border:
        1px solid
        rgba(79,163,209,0.20);

      border-radius: 25px;

      background: var(--white);

      box-shadow: var(--shadow-sm);
    }

    .airtime-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .airtime-network {
      display: flex;
      align-items: center;
      gap: 10px;

      font-size: 1rem;
      font-weight: 900;
    }

    .airtime-icon {
      width: 42px;
      height: 42px;

      display: grid;
      place-items: center;

      border-radius: 12px;

      background: var(--navy);

      color: var(--blue);

      font-size: 0.70rem;
      font-weight: 950;
    }

    .listed {
      color: var(--muted);

      font-size: 0.65rem;
      font-weight: 850;

      text-transform: uppercase;
      letter-spacing: 0.8px;
    }

    .airtime-rate {
      margin: 22px 0 5px;

      color: var(--navy);

      font-size: 4rem;
      font-weight: 950;

      line-height: 1;

      letter-spacing: -3px;
    }

    .airtime-text {
      margin-bottom: 21px;

      color: var(--muted);

      font-size: 0.78rem;
    }


    /* =========================================================
       DECISION SECTION
    ========================================================= */

    .decision-section {
      background: var(--white);
    }

    .decision-grid {
      display: grid;

      grid-template-columns:
        1fr 1fr;

      gap: 45px;

      align-items: center;
    }

    .decision-content h2 {
      margin: 16px 0;

      color: var(--navy);

      font-size:
        clamp(2.2rem, 5vw, 3.6rem);

      line-height: 1.04;

      letter-spacing: -2px;
    }

    .decision-content > p {
      color: var(--muted);

      font-size: 0.88rem;
    }

    .decision-list {
      display: grid;
      gap: 12px;

      margin-top: 25px;

      list-style: none;
    }

    .decision-list li {
      display: flex;
      gap: 11px;

      color: #334155;

      font-size: 0.81rem;
    }

    .decision-check {
      flex-shrink: 0;

      width: 23px;
      height: 23px;

      display: grid;
      place-items: center;

      border-radius: 8px;

      background: var(--green-soft);

      color: #059669;

      font-size: 0.65rem;
      font-weight: 950;
    }

    .decision-card {
      padding: 30px;

      border-radius: 26px;

      background: var(--navy);

      color: var(--white);

      box-shadow: var(--shadow-lg);
    }

    .decision-card h3 {
      margin: 17px 0 8px;

      font-size: 1.8rem;

      line-height: 1.08;
    }

    .decision-card > p {
      color: #AFC4D4;

      font-size: 0.80rem;
    }

    .decision-stat-grid {
      display: grid;

      grid-template-columns:
        repeat(2, 1fr);

      gap: 10px;

      margin-top: 24px;
    }

    .decision-stat {
      padding: 17px;

      border:
        1px solid
        rgba(255,255,255,0.08);

      border-radius: 13px;

      background:
        rgba(255,255,255,0.035);
    }

    .decision-stat strong {
      display: block;

      color: var(--blue);

      font-size: 1.5rem;
    }

    .decision-stat span {
      color: #8299AA;

      font-size: 0.64rem;
    }


    /* =========================================================
       PROCESS
    ========================================================= */

    .process-section {
      background: var(--off-white);
    }

    .process-grid {
      display: grid;

      grid-template-columns:
        repeat(3, 1fr);

      gap: 15px;
    }

    .process-card {
      padding: 26px;

      border:
        1px solid
        var(--border);

      border-radius: 18px;

      background: var(--white);
    }

    .process-number {
      display: inline-flex;

      margin-bottom: 18px;

      padding: 6px 9px;

      border-radius: 8px;

      background: var(--blue-soft);

      color: var(--blue-dark);

      font-size: 0.62rem;
      font-weight: 950;
    }

    .process-card h3 {
      margin-bottom: 7px;

      color: var(--navy);

      font-size: 1rem;
    }

    .process-card p {
      color: var(--muted);

      font-size: 0.78rem;
    }


    /* =========================================================
       CTA
    ========================================================= */

    .cta-section {
      padding-top: 70px;
      padding-bottom: 100px;

      background: var(--white);
    }

    .cta-box {
      position: relative;

      padding: 70px 25px;

      text-align: center;

      border-radius: 30px;

      background:
        radial-gradient(
          circle at 50% 0%,
          rgba(79,163,209,0.20),
          transparent 45%
        ),
        var(--navy);

      color: var(--white);

      overflow: hidden;

      box-shadow: var(--shadow-lg);
    }

    .cta-box h2 {
      max-width: 730px;

      margin: 18px auto 13px;

      font-size:
        clamp(2.2rem, 5vw, 3.7rem);

